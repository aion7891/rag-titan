# Copy this file to .env and change what you need.
# Every value below is the default.

# LLM used by RAG: ollama (local) or anthropic (Claude; "claude" works too)
LLM_PROVIDER=ollama
# leave the models unset to use the provider's default:
#   ollama: gemma3:4b (agents: qwen3:4b)   anthropic: claude-haiku-5-5
# LLM_MODEL=gemma3:4b
OLLAMA_HOST=http://localhost:11434
# Claude only: your key from https://console.anthropic.com (keep .env private)
# ANTHROPIC_API_KEY=sk-ant-...

# LLM used by agents (needs tool-calling support)
# AGENT_MODEL=qwen3:4b
AGENT_THINK=true
AGENT_MAX_STEPS=5

# Embeddings
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# Chunking: word, character, token, recursive, sentence, paragraph, heading, page
# CHUNK_SIZE and CHUNK_OVERLAP count words (word), tokens (token) or characters
CHUNKER=word
CHUNK_SIZE=150
CHUNK_OVERLAP=30
# token chunker only (needs: pip install "rag-titan[tokens]")
CHUNK_ENCODING=cl100k_base
# parent_child RAG only: largest parent section in characters (children use CHUNKER)
PARENT_SIZE=1500

# Storage, retrieval and generation
# memory: forgotten when Python exits. Saved (index once, ask later):
#   sqlite  one file, nothing to install
#   chroma  pip install "rag-titan[chroma]"
#   qdrant  pip install "rag-titan[qdrant]"
VECTOR_STORE=memory
# file (sqlite) or folder (chroma, qdrant); default: rag_titan.db / rag_titan_chroma / rag_titan_qdrant
# VECTOR_STORE_PATH=rag_titan.db
# chroma / qdrant on a server instead of a folder, and the collection (one per index)
# VECTOR_STORE_URL=http://localhost:6333
# COLLECTION=rag_titan
# QDRANT_API_KEY=...            # Qdrant Cloud only
DEDUPE_OVERLAP=0.5      # drop search results that repeat a better one; off to keep all
RETRIEVER=dense         # dense (meaning), bm25 (exact words) or hybrid (both, RRF)
RERANKER=keyword        # keyword, none, mmr (relevant, not repetitive), llm or cross_encoder
# cross_encoder only (needs: pip install "rag-titan[rerank]")
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Tuning: how much each RAG type searches and keeps
# empty = each type's own default (simple 5/2, adaptive 4/2, parent_child 8/4,
# hyde, rag_fusion and corrective 5/2, iterative 3/2 per search)
TOP_K=
TOP_N=
# adaptive: searches (with a rewritten question) before giving up
ADAPTIVE_MAX_ATTEMPTS=2
# parent_child: most characters of parent sections given to the model
PARENT_BUDGET=3000
# hyde: also search with the question and fuse it with the made-up answer's search
HYDE_WITH_QUESTION=true
# rag_fusion: rewordings of the question to search with (1 to 10)
FUSION_QUERIES=3
# corrective: a chunk graded at least CRAG_UPPER (0-10) makes the evidence good;
# all below CRAG_LOWER makes it bad (thrown away, searched again)
CRAG_UPPER=7
CRAG_LOWER=3
# corrective: keep only the useful sentences of the chunks the model reads
CRAG_REFINE=true
# corrective: times to search again with a rewritten question (0: grade only)
CRAG_MAX_RETRIES=1
# iterative: think-then-search rounds after the first search (0: search once)
ITERATIVE_MAX_STEPS=3
GENERATOR=grounded

# Logging: DEBUG, INFO or WARNING
LOG_LEVEL=INFO
